{
  "name": "@finecomb/corpus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Synthetic bill corpus, ground-truth labeler and accuracy evaluator for the Finecomb engine.",
  "scripts": {
    "generate": "vite-node src/run-generate.ts",
    "generate:holdout": "vite-node src/run-holdout.ts",
    "evaluate": "vite-node src/run-evaluate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "evaluate:handmade": "vite-node src/run-handmade.ts"
  },
  "dependencies": {
    "@finecomb/engine": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
